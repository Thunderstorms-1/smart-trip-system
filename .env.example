# Copy AI entries into the ignored .env for scripts/Start-Backend.ps1 or Docker Compose.
# Keep both switches false until the account/model free allowance is verified.
SMARTTRIP_AI_ENABLED=false
SMARTTRIP_AI_FREE_QUOTA_VERIFIED=false
SMARTTRIP_AI_KEY=
SMARTTRIP_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMARTTRIP_AI_MODEL=qwen3.8-flash
SMARTTRIP_AI_MAX_OUTPUT_TOKENS=8192

# Optional local RAG: launch compose.rag.yaml separately; no paid generation calls.
SMARTTRIP_RAG_ENABLED=false
SMARTTRIP_RAG_FALLBACK=true
SMARTTRIP_RAG_ES_URL=http://127.0.0.1:9200
SMARTTRIP_RAG_ES_USERNAME=elastic
SMARTTRIP_RAG_ES_PASSWORD=
SMARTTRIP_RAG_INDEX=smarttrip-travel-v1
SMARTTRIP_RAG_EMBEDDING_URL=http://127.0.0.1:11434
SMARTTRIP_RAG_EMBEDDING_MODEL=bge-m3
SMARTTRIP_RAG_EMBEDDING_VERSION=v1
SMARTTRIP_RAG_RERANK_ENABLED=false
SMARTTRIP_RAG_RERANK_URL=http://127.0.0.1:8010/rerank

# Docker application stack: supply your own values locally; never commit them.
SMARTTRIP_DB_PASSWORD=
SMARTTRIP_MYSQL_ROOT_PASSWORD=
SMARTTRIP_JWT_SECRET=
